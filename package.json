{
  "name": "ts-deep-types",
  "version": "0.1.0-beta.1",
  "description": "Type-safe utility types for TypeScript. Deep types, string manipulation, function helpers, and React integration.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "typescript",
    "types",
    "utilities",
    "type-fest",
    "utility-types",
    "deep-types",
    "type-safety"
  ],
  "author": "Peter <peter@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/ts-deep-types"
  },
  "bugs": {
    "url": "https://github.com/username/ts-deep-types/issues"
  },
  "homepage": "https://ts-deep-types.dev",
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.3.0",
    "vitest": "^2.0.0",
    "vitepress": "^1.3.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
